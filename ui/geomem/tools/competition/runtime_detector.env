# Candidate profile is versioned with this release; explicit environment overrides win.
# 或把 console-current 软链切回 console-direct-38d44dc。
# Back to the old pair: ln -sfn console-direct-4a7fa68 console-current (old engine: floor-20261027/refined, profile combined).
export YOLO_PROFILE="${YOLO_PROFILE:-combined33}"
export YOLO_ENGINE="${YOLO_ENGINE:-/data/fpga/dev3/saiyong1-20261031/models/saiyong1-fp16.engine}"

export YOLO_COCO_MODEL="${YOLO_COCO_MODEL:-/data/fpga/yolo_engine_20261015/yolov8n-seg-640-fp16.engine}"
# 10-30 (owner): combined33 split. all33 = the six demo items all on the 33-class model (COCO engine not loaded);
# rollback to the old split (33-class only medicine box): start with CAR_YOLO_ROUTE=primary in front.
export CAR_YOLO_ROUTE="${CAR_YOLO_ROUTE:-all33}"
