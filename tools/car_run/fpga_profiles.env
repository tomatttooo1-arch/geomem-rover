# FPGA profile of the car: THE one place (go-live 2026-10-26). Plain KEY=VALUE lines only
# (no quotes, no inline comments): sourced by tools/car_run/fpga_profile.sh (Nano car_up,
# board_preflight, KV kv_start.sh) and parsed by ui/geomem/tools/competition/kv_service.py.
#   a2        m7_pl_merge_a2 (0x00da5041): the 10-14 record bitstream, rolling map on the Nano
#             CPU. The rollback: FPGA_PROFILE=a2 (one run) or FPGA_PROFILE_DEFAULT=a2 (for good).
#   v3fc2     m7_pl_v3fc2 (0x03c087c9): v3fc + the stop-permit window configurable at run time
#             (power-on 1000 ms, clamp 100..5000 ms); fast clock 150 MHz step = 142.86 MHz real, WNS +0.190.
#             The default from the 10-26 board short test until SMOKE2 (11-03) (runs/fpga-innov-20261025/board/SHORTTEST_20261026.md,
#             23:29-23:37): pl1_ref 142857142 Hz, rec30 geometry 310 frames byte-exact, fusion 489 records 0 mismatch,
#             permit window/expiry/FORCE_STOP all pass; rec30 geometry device time median 3.823 ms (A2 5.281 ms, 1.38x).
#   v3fc2_166 m7_pl_v3fc2_166: the SAME BUILD_ID 0x03c087c9 (same RTL), fast clock 166.66 MHz, WNS +0.005;
#             the two packages are told apart by the app name (and pl1_ref clk_rate), not by BUILD_ID.
#             10-26 board short test: passes too (pl1_ref 166666665 Hz, geometry/fusion exact, 3.360 ms, 1.57x).
#   v3fc3_187 m7_pl_v3fc3 (0x042a646f): optional; v3fc2 with the AR core moved to the 100 MHz clock (as in A2),
#             frame/ROI fast clock 187.50 MHz (187498123 Hz), WNS +0.011 after post-route phys_opt.
#             PAUSED (10-26 board short test): the board ran pl1_ref at 199999998 Hz, not 187.5 MHz -- the kernel put
#             pl_clk1 under the 1000 MHz IOPLL and its integer divider rounded 187.5 to /5 = 200 MHz, above the
#             timing-closed clock. Until the 187.5 MHz clock is fixed and passes on the board, V3FC3_187_USE=v3fc2
#             makes FPGA_PROFILE=v3fc3_187 warn and run v3fc2 (tools/car_run/fpga_profile.sh; Nano and KV260).
#             The BUILD_ID stays registered: a KV260 loaded by hand with m7_pl_v3fc3 is still accepted by car_up
#             (any registered build, owner 10-26) -- that bypasses the profile choice and runs at 200 MHz.
#   v3fc      m7_pl_v3fc (0x001256b1): frame + ROI + AR + rolling fusion core (slot 5) on the KV260
#             PL, fixed 1000 ms permit window; the Nano producer fuses through it (--rolling-backend remote_pl).
#   m1_166    m7_pl_m1_166 (0x08051f22; nationals MERGE1, hardware source 8051f22): geometry core slimmed (write-back
#             clear, G3 conv-slim, G1d ray thinning register DLAT2_EN), fused core with op GRID (B1), NO car-screen (AR)
#             core: SLOT_MAP 0x263 (bit 8 clear). Fast clock 166.67 MHz, route WNS +0.006 ns (no margin).
#             BOARD2 board test 2026-11-03 01:10-02:01 (runs/nationals-prelim-20261102/BOARD2/README.md): pl1_ref
#             166666665 Hz, info PASS; rec30 310 frames byte-exact, device time median 3.162 ms (v3fc2 3.824 ms same
#             session, -17.3%; ray thinning on 2.681 ms); GRID 1239 records 0 mismatch; ROI concurrent switch 0/1
#             row-identical. <P>_AR=nano: the car screen is drawn on the Nano (AR2NANO2, producer --ar-nano): nano_up /
#             car_up turn CAR_AR_NANO on by themselves, kv_start never tries the KV AR start for it.
#   m1        m7_pl_m1: the SAME BUILD_ID 0x08051f22, fast clock 142.86 MHz (WNS +0.383), the fallback of m1_166
#             (BOARD2: rec30 byte-exact, 3.596 ms; GRID 0 mismatch). Told apart from m1_166 by the app name.
#   m2_166    m7_pl_m2_166 (0x07da3d4a; nationals MERGE2, hardware source 7da3d4a): m1 + slimmed ROI core (SLIM_ROI1)
#             + geometry write-back as one 32-bit burst (WB_BURST; the flags buffer must be 4-byte aligned, checked by
#             the host driver, not by the circuit); NO car-screen (AR) core, SLOT_MAP 0x263. Fast clock 166.67 MHz,
#             route WNS +0.115 ns, board LUT 47,108 (runs/nationals-prelim-20261102/MERGE2/README.md).
#             Board test (BOARD3, 2026-11-03, runs/nationals-prelim-20261102/BOARD3/README.md): pl1_ref 166,666,665 Hz;
#             rec30 geometry core median 2.100 ms (v3fc2 3.821 same session), empty frame 0.200 ms; bit-exact
#             (rec30 310 frames x2 0 diff, GRID 1,239 records 0 diff, ROI 0 diff vs m1); route margin +0.115 ns.
#             THE DEFAULT since SMOKE2 (2026-11-03, runs/nationals-prelim-20261102/SMOKE2/README.md): in-place
#             whole-chain smoke, camera + Nano + m2_166, car not moving (no chassis driver), 12.5 min: 11,205 frames
#             at 15.0 fps, all fused (1 start-up drop), ROI ok, costmap out, geometry core median 6.71 ms on the live
#             scene (v3fc2 same scene 9.51 ms). Rollback: FPGA_PROFILE=v3fc2 (one run) or this line back to v3fc2.
#   m2        m7_pl_m2: the SAME BUILD_ID 0x07da3d4a, fast clock 142.86 MHz (route WNS +0.143), the fallback of m2_166.
#             Board test (BOARD3): pl1_ref 142,857,142 Hz; rec30 geometry core median 2.445 ms, empty frame
#             0.233 ms; bit-exact (rec30 310 frames x2 0 diff). Told apart from m2_166 by the app name.
#   <P>_AR (optional): nano = the bitstream has no AR core, the Nano draws the car screen; absent = kv (as before).
# Switching: for one run FPGA_PROFILE=v3fc2 (or v3fc2_166 / v3fc3_187 / v3fc / a2 / m1_166 / m1 / m2_166 / m2) on the Nano in front of
# car_up / nano_up (e.g. FPGA_PROFILE=v3fc2 bash tools/car_run/car_up.sh live ...); for good change the
# one line FPGA_PROFILE_DEFAULT below. The KV260 is started with that profile name (a2 = no argument,
# also what every older installed helper does).
# The board precheck accepts ANY registered BUILD_ID below (and follows the build actually
# loaded: its profile's Nano rolling backend); the profile only decides which app is loaded.
FPGA_PROFILE_DEFAULT=m2_166
# E7 (nationals prelim 2026-11-02): KV server per-pixel data plane in C++ (kv_server --kv-fast native: codes crc32,
# u16 -> float32 conversion and depth crc32 in one NEON + crc32-instruction pass; same bytes as Python). off = the
# Python path exactly as before. Any profile; kv_start.sh adds --kv-fast native only when this says native.
# Rollback = set it back to off (or keep off and try one run by hand, runs/nationals-prelim-20261102/E7/).
# E7B 2026-11-03: native by default (board A/B on m2_166, runs/nationals-prelim-20261102/E7B/).
FPGA_KV_FAST_DEFAULT=native
V3FC2_APP=m7_pl_v3fc2
V3FC2_BUILD_ID=0x03c087c9
V3FC2_KV_ROLLING=pl
V3FC2_NANO_ROLLING=remote_pl
V3FC2_166_APP=m7_pl_v3fc2_166
V3FC2_166_BUILD_ID=0x03c087c9
V3FC2_166_KV_ROLLING=pl
V3FC2_166_NANO_ROLLING=remote_pl
V3FC3_187_APP=m7_pl_v3fc3
V3FC3_187_BUILD_ID=0x042a646f
V3FC3_187_KV_ROLLING=pl
V3FC3_187_NANO_ROLLING=remote_pl
V3FC3_187_USE=v3fc2
V3FC_APP=m7_pl_v3fc
V3FC_BUILD_ID=0x001256b1
V3FC_KV_ROLLING=pl
V3FC_NANO_ROLLING=remote_pl
A2_APP=m7_pl_merge_a2
A2_BUILD_ID=0x00da5041
A2_KV_ROLLING=none
A2_NANO_ROLLING=cpu
M1_APP=m7_pl_m1
M1_BUILD_ID=0x08051f22
M1_KV_ROLLING=pl
M1_NANO_ROLLING=remote_pl
M1_AR=nano
M1_166_APP=m7_pl_m1_166
M1_166_BUILD_ID=0x08051f22
M1_166_KV_ROLLING=pl
M1_166_NANO_ROLLING=remote_pl
M1_166_AR=nano
M2_APP=m7_pl_m2
M2_BUILD_ID=0x07da3d4a
M2_KV_ROLLING=pl
M2_NANO_ROLLING=remote_pl
M2_AR=nano
M2_166_APP=m7_pl_m2_166
M2_166_BUILD_ID=0x07da3d4a
M2_166_KV_ROLLING=pl
M2_166_NANO_ROLLING=remote_pl
M2_166_AR=nano
