            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="north_collision">
          <pose>0 3 1 0 0 0</pose>
          <geometry>
            <box>
              <size>6.2 0.2 2</size>
