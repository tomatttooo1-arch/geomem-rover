            <diffuse>0.03 0.08 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="fpga_robot">
      <pose>0 0 0.005 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <pose>0 0 0.20 0 0 0</pose>
          <mass>5</mass>
          <inertia>
            <ixx>0.08</ixx>
            <iyy>0.1</iyy>
            <izz>0.12</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.30 0.16</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.30 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.6 1</ambient>
            <diffuse>0.1 0.2 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="camera_collision">
          <pose>0.13 0 0.35 0 0.471238898 0</pose>
          <geometry>
            <box>
              <size>0.06 0.10 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="camera_visual">
          <pose>0.13 0 0.35 0 0.471238898 0</pose>
          <geometry>
            <box>
              <size>0.06 0.10 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <sensor name="rgbd" type="rgbd_camera">
          <pose>0.13 0 0.35 0 0.471238898 0</pose>
          <topic>/fpga/rgbd</topic>
          <ignition_frame_id>camera_optical_frame</ignition_frame_id>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <optical_frame_id>camera_optical_frame</optical_frame_id>
            <horizontal_fov>1.58</horizontal_fov>
            <image>
              <width>640</width>
              <height>400</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>6</far>
            </clip>
          </camera>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.18 0.10 -1.5707963267948966 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.0008</ixx>
            <iyy>0.0008</iyy>
            <izz>0.0015</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="left_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="left_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.04 0.04 0.04 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="right_wheel">
        <pose>0 -0.18 0.10 -1.5707963267948966 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.0008</ixx>
            <iyy>0.0008</iyy>
            <izz>0.0015</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="right_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="right_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.04 0.04 0.04 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>
      <link name="front_caster">
        <pose>0.16 0 0.035 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.5e-05</ixx>
            <iyy>2.5e-05</iyy>
            <izz>2.5e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="front_visual">
          <geometry>
            <sphere>
              <radius>0.035</radius>
            </sphere>
          </geometry>
        </visual>
        <collision name="front_collision">
          <geometry>
            <sphere>
              <radius>0.035</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
      <joint name="front_caster_joint" type="ball">
        <parent>base_link</parent>
        <child>front_caster</child>
      </joint>
      <link name="rear_caster">
        <pose>-0.16 0 0.035 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.5e-05</ixx>
            <iyy>2.5e-05</iyy>
            <izz>2.5e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="rear_visual">
          <geometry>
            <sphere>
              <radius>0.035</radius>
            </sphere>
          </geometry>
        </visual>
        <collision name="rear_collision">
          <geometry>
            <sphere>
              <radius>0.035</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
      <joint name="rear_caster_joint" type="ball">
        <parent>base_link</parent>
        <child>rear_caster</child>
      </joint>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/fpga/cmd_vel</topic>
        <odom_topic>/fpga/wheel_odom_unused</odom_topic>
        <tf_topic>/fpga/wheel_tf_unused</tf_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.25</max_linear_velocity>
        <min_linear_velocity>-0.15</min_linear_velocity>
        <max_angular_velocity>0.6</max_angular_velocity>
        <min_angular_velocity>-0.6</min_angular_velocity>
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>1</max_angular_acceleration>
        <min_angular_acceleration>-1</min_angular_acceleration>
      </plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>/fpga/reference_odom</odom_topic>
        <tf_topic>/fpga/reference_tf</tf_topic>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>