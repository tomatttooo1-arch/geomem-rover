          </geometry>
          <material>
            <ambient>0.8 0.02 0.02 1</ambient>
            <diffuse>0.8 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <collision name="book_pages_collision">
          <pose>1.10 0.45 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.24 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="book_pages_visual">
          <pose>1.10 0.45 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.24 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.90 0.85 1</ambient>
            <diffuse>0.92 0.90 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="book_cover_collision">
          <pose>1.10 0.45 0.048 0 0 0</pose>
          <geometry>
            <box>
              <size>0.19 0.25 0.006</size>
            </box>
          </geometry>
        </collision>
        <visual name="book_cover_visual">
          <pose>1.10 0.45 0.048 0 0 0</pose>
          <geometry>
            <box>
              <size>0.19 0.25 0.006</size>
            </box>
          </geometry>
          <material>
