<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <!-- Car-mount variant of room.sdf (2026-10-14, line D1; default world of simulation.launch.py).
       Camera as on the car (sil-assess-20261014 smoke3 room_carmount.sdf): base_link -> camera
       0.13 0 0.35, pitch 0.471238898 (27 deg down), horizontal FOV 1.58 rad, 640x400; the camera
       visual/collision follow the sensor; the 0.95 m mast and bracket of the old mount are removed.
       Props moved from the 0.70 m table top (out of view of a 0.35 m camera pitched 27 deg down:
       top edge of its view is 5 deg above horizontal) to the floor in front of the table, x 1.10,
       same y and the same heights above their support. Architecture, robot and plugins unchanged.
       Smoke-period change (D1 smoke 05, PREREG section 5): props x 1.25 -> 1.10 and the 09-probe
       "bright" light (render_variants.py: ambient 0.8, sun diffuse 1, direction 0.4 0 -1, no
       attenuation): at x 1.25 / original light SSDLite (score gate 0.4 unchanged) gave the bottle
       0.16 (0.27 with hflip_shift4) from the start pose, so no bottle was ever remembered.
       Modelled values, not measurements. room.sdf (0.95 m mast) stays as the 09-16 AGX evidence world. -->
  <world name="fpga_room">
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.4 0.0 -1.0</direction>
      <attenuation>
        <range>1000</range>
        <constant>1.0</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>
    <model name="architecture">
      <static>true</static>
      <link name="structure">
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>6.4 6.4 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>6.4 6.4 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
        <collision name="west_collision">
          <pose>-3 0 1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 6.2 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="west_visual">
          <pose>-3 0 1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 6.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="east_collision">
          <pose>3 0 1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 6.2 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="east_visual">
