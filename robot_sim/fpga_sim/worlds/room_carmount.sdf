          </material>
        </visual>
        <collision name="bottle_neck_collision">
          <pose>1.10 -0.45 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bottle_neck_visual">
          <pose>1.10 -0.45 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.4 0.1 1</ambient>
            <diffuse>0.05 0.4 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="bottle_cap_collision">
          <pose>1.10 -0.45 0.285 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.024</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bottle_cap_visual">
          <pose>1.10 -0.45 0.285 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.024</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <collision name="cup_collision">
          <pose>1.10 0.0 0.06 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="cup_visual">
          <pose>1.10 0.0 0.06 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.02 0.02 1</ambient>
            <diffuse>0.8 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <collision name="cup_handle_collision">
          <pose>1.10 0.08 0.07 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.04 0.075</size>
            </box>
          </geometry>
        </collision>
        <visual name="cup_handle_visual">
          <pose>1.10 0.08 0.07 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.04 0.075</size>
