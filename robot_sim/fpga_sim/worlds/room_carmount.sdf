          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="south_collision">
          <pose>0 -3 1 0 0 0</pose>
          <geometry>
            <box>
              <size>6.2 0.2 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -3 1 0 0 0</pose>
          <geometry>
            <box>
              <size>6.2 0.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="table_collision">
          <pose>1.8 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 1.6 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <pose>1.8 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 1.6 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.08 1</ambient>
            <diffuse>0.4 0.2 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rendered_props">
      <static>true</static>
      <link name="props">
        <collision name="bottle_body_collision">
          <pose>1.10 -0.45 0.11 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="bottle_body_visual">
