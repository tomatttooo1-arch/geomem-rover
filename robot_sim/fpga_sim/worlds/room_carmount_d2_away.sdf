  <model name="bottle_prop"><static>true</static><pose>1.2500 -0.4500 0 0 0 0.0000</pose><link name="bottle"><collision name="bottle_collision"><pose>0 0 0.1500 0 0 0</pose><geometry><cylinder><radius>0.0375</radius><length>0.3000</length></cylinder></geometry></collision><visual name="bottle_visual"><geometry><mesh><uri>/opt/fpga_ws/install/share/fpga_sim/worlds/props/bottle_wine_green.obj</uri><scale>1 1 1</scale></mesh></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.6 0.6 0.6 1</specular><pbr><metal><albedo_map>/opt/fpga_ws/install/share/fpga_sim/worlds/props/bottle_wine_green.png</albedo_map><roughness>0.25</roughness><metalness>0.0</metalness></metal></pbr></material></visual></link></model></world>
