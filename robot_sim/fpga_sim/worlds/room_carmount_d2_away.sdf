<?xml version='1.0' encoding='utf-8'?>
<!-- 10-18 memory-persist E2 (docs/design/MEMORY_PERSIST_20261018.md section 6): room_carmount_d2.sdf with the
     robot's initial yaw turned by pi only (the bottle unchanged): from the spawn the camera does not see the bottle. -->
<sdf version="1.8">
  <!-- Line D2 world (2026-10-14; run_sim_loop.sh default FPGA_SIM_WORLD_FILE). Generated from room_carmount.sdf
       (the D1 world, unchanged) by tools/sim_loop/bottle_world.py with bottle wine_green, x 1.25, y -0.45,
       light orig, props x 1.25 (exact command: runs/sim-loop-d2-20261014-results/README.md)
       i.e. the original pre-D1 scene (props on the floor at x 1.25, the original sun light) with the D1 green
       cylinder bottle replaced by a textured mesh wine bottle (worlds/props/bottle_wine_green.obj/.png, made by
       props/make_bottle_mesh.py, 0.30 m tall, r 0.0375 m; collision = a cylinder of that size).
       Why (D2 smoke-period change, PREREG section 5): the host YOLO (conf 0.25, unchanged) gives the D1 cylinder
       bottle no bottle box at all at x 1.25 / original light, and 0.12 at D1's x 1.10 / bright; this mesh bottle
       scores 0.43 from the start pose (render probe runs/sim-loop-d2-20261014-results/probe1). Modelled values. -->
  <world name="fpga_room">
    <!-- bottle_world.py: bottle=wine_green x=1.250 y=-0.450 yaw=0.000 scale=1 light=orig props_x=1.25 --><physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <model name="architecture">
