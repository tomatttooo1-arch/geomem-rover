    <model name="fpga_robot">
      <pose>0 0 0.005 0 0 3.14159265</pose>
      <link name="base_link">
        <inertial>
          <pose>0 0 0.20 0 0 0</pose>
          <mass>5</mass>
          <inertia>
            <ixx>0.08</ixx>
            <iyy>0.1</iyy>
            <izz>0.12</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
